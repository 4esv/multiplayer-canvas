{# The kit's pictures at their hashes (#313, #319): included by any page that
   wears the kit. kit.css reads the parts as --kp-<part>-<state>, js/kit.js
   swaps pictures from the JSON map; neither writes an /img URL itself. #}
{%- set kimg = kitImg() %}
<style>:root { {% for f, u in kimg %}--kp-{{ f }}: url('{{ u }}'); {% endfor %}}</style>
<script type="application/json" id="kit-img">{{ kimg | safeJson | safe }}</script>
