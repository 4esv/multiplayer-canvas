{%- if grid.isTerminal or grid.isRetro -%}
{% extends "base-retro.njk" if grid.isRetro else "base-text.njk" %}
{% block text %}
404 · not found
===============

{{ route }} doesn't exist.

Try one of these instead:
  /         home
  /work     case studies + hire-me
  /feed     writing & web
  /about    bio

{{ site.url }}/
{% endblock %}
{%- else -%}
{% extends "canvas-base.njk" %}
{% block content %}
  <main class="cv-door cv-lost">
    {# the page is thin: a pointer carves it away to the black under (canvas/abyss.js,
       started by js/door.js), and the words stand on a plate that stays #}
    <canvas class="cv-abyss" aria-hidden="true"></canvas>
    <div class="cv-plate">
      {{ '404' | pixelTitle }}
      <p class="cv-status"><code class="cv-path">{{ route }}</code> doesn't exist. Maybe it never did, maybe it moved. Either way, pick a direction.</p>
      <nav class="k-bank" aria-label="somewhere real">
        <a class="k-btn is-on" href="/">&#8592; canvas</a>
        <a class="k-btn" href="/work">/work</a>
        <a class="k-btn" href="/feed">/feed</a>
        <a class="k-btn" href="/about">/about</a>
      </nav>
    </div>
  </main>
{% endblock %}
{%- endif -%}
