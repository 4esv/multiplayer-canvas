{
  "name": "multiplayer-canvas",
  "version": "0.1.0",
  "description": "A multiplayer toroidal canvas for a site, and the primitives it is built from.",
  "type": "module",
  "exports": {
    "./pixel-type": "./primitives/pixel-type.js",
    "./dust": "./primitives/dust.js",
    "./pixel-moves": "./primitives/pixel-moves.js",
    "./dither": "./primitives/textmode-settings.js",
    "./grid": "./primitives/grid.js",
    "./torus": "./primitives/torus.js",
    "./mirror": "./primitives/mirror.js",
    "./presence": "./primitives/presence/presence.js",
    "./presence/room": "./primitives/presence/presence-room.js",
    "./presence/protocol": "./primitives/presence/presence-protocol.js",
    "./presence/wire": "./primitives/presence/wire.js",
    "./presence/anchor": "./primitives/presence/anchor.js",
    "./presence/conga": "./primitives/presence/conga.js",
    "./rooms": "./primitives/rooms/sessions.js",
    "./rooms/url": "./primitives/rooms/finder-url.js",
    "./rooms/follow": "./primitives/rooms/follow.js",
    "./rooms/view-sync": "./primitives/rooms/view-sync.js",
    "./slime": "./primitives/slime/slime.js",
    "./slime/server": "./primitives/slime/server.js",
    "./sky": "./primitives/sky/outlook.js",
    "./sky/server": "./primitives/sky/server.js",
    "./kit/scroll": "./primitives/kit/kit-scroll.js",
    "./kit/caret": "./primitives/kit/kit-caret.js",
    "./kit/arm": "./primitives/kit/kit-arm.js",
    "./kit/marquee": "./primitives/kit/kit-marquee.js",
    "./kit/tags": "./primitives/kit/tags.js",
    "./kit.css": "./primitives/kit/kit.css",
    "./tokens.css": "./primitives/kit/canvas-tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "primitives/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "node scripts/build-assets.mjs",
    "test": "NODE_ENV=test node --test 'test/**/*.test.js'",
    "test:watch": "node --test --watch 'test/**/*.test.js'",
    "lint": "eslint primitives/ src/ scripts/",
    "design:lint": "design.md lint BIBLE.md",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run verify:dead-exports && npm run verify:guards && npm run design:lint && npm run format:check && npm run test",
    "verify:dead-exports": "node scripts/verify/dead-exports.mjs",
    "verify:guards": "node scripts/verify/mutate.mjs --static",
    "verify:mutate": "node scripts/verify/mutate.mjs",
    "verify:world": "node scripts/verify/world-fixed.mjs",
    "verify:page-presence": "node scripts/verify/page-presence.mjs",
    "verify:frames": "node scripts/verify/frame-gesture.mjs",
    "verify:motion": "node scripts/verify/instrument-motion.mjs",
    "verify:slime": "node scripts/verify/slime-wire.mjs",
    "verify:slime-asleep": "node scripts/verify/slime-asleep.mjs",
    "verify:sky": "node scripts/verify/sky-wire.mjs",
    "verify:boot-dom": "node scripts/verify/boot-dom.mjs",
    "verify:waste": "node scripts/verify/waste.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:ci": "npm run check && npm run audit:prod",
    "verify:ground": "node scripts/verify/page-ground.mjs",
    "verify:interface": "node scripts/verify/interface.mjs",
    "verify:figures": "node scripts/verify/figure-fit.mjs",
    "verify:gates": "node scripts/verify/local-gates.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/view": "^12.0.1",
    "@fastify/websocket": "^11.3.4",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.12.4",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
