# Copy to .env. Every value is optional: the defaults below are what the
# server uses when a line is absent. Who the site is lives in site.config.js.

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Overrides for site.config.js, so a staging box can run the same tree.
# SITE_NAME=Your Name
# SITE_URL=https://example.com

# Which peers may set X-Forwarded-* (a proxy-addr spec). Production
# defaults to `uniquelocal`, i.e. a reverse proxy on a private network.
# TRUST_PROXY=uniquelocal

# Runtime stores, relative to the process cwd. Mount data/ as a volume.
# AUTH_STORE_PATH=data/auth.json
# AUDIT_DIR=data/audit
# ROOMS_STORE_PATH=data/rooms.json
